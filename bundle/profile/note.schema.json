{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/okf-plus/rehearsal/profile/note.schema.json",
  "title": "Independent early-years rehearsal note; NOT the canonical Bundle Wiki schema",
  "type": "object",
  "required": [
    "@context",
    "@id",
    "@type",
    "type",
    "route",
    "title",
    "description",
    "tags",
    "generated",
    "sources",
    "facts",
    "fixture_scope",
    "status",
    "assertions"
  ],
  "properties": {
    "@context": {
      "type": "string",
      "format": "uri"
    },
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "type": "string",
      "minLength": 1
    },
    "route": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "generated": {
      "type": "object",
      "required": [
        "by",
        "at"
      ],
      "properties": {
        "by": {
          "type": "string",
          "minLength": 1
        },
        "at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "url",
          "source_artifact",
          "source_sha256",
          "locator",
          "retrieved_at"
        ],
        "properties": {
          "url": {
            "type": "string",
            "format": "uri"
          },
          "source_artifact": {
            "type": "string",
            "minLength": 1
          },
          "source_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "locator": {
            "type": "string",
            "minLength": 1
          },
          "retrieved_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": true
      }
    },
    "facts": {
      "type": "object"
    },
    "fixture_scope": {
      "const": "synthetic-fixture"
    },
    "status": {
      "const": "experimental"
    },
    "assertions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "@id",
          "@type",
          "source",
          "predicate",
          "target",
          "kind",
          "label",
          "inverse_label",
          "assertion_status",
          "assertion_scope",
          "authority",
          "derivation",
          "observed_at",
          "evidence",
          "rights"
        ],
        "properties": {
          "@id": {
            "type": "string",
            "format": "uri"
          },
          "@type": {
            "const": [
              "rdf:Statement",
              "ey:RelationshipAssertion"
            ]
          },
          "source": {
            "type": "string",
            "format": "uri"
          },
          "predicate": {
            "type": "string",
            "format": "uri"
          },
          "target": {
            "type": "string",
            "format": "uri"
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "inverse_label": {
            "type": "string",
            "minLength": 1
          },
          "assertion_status": {
            "const": "normalized"
          },
          "assertion_scope": {
            "const": "synthetic-fixture"
          },
          "authority": {
            "type": "object",
            "required": [
              "class",
              "label",
              "source"
            ],
            "properties": {
              "class": {
                "const": "synthetic"
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "source": {
                "type": "string",
                "format": "uri"
              }
            },
            "additionalProperties": false
          },
          "derivation": {
            "type": "string",
            "format": "uri"
          },
          "observed_at": {
            "type": "string",
            "format": "date-time"
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "url",
                "source_artifact",
                "source_sha256",
                "locator",
                "retrieved_at"
              ],
              "properties": {
                "url": {
                  "type": "string",
                  "format": "uri"
                },
                "source_artifact": {
                  "type": "string",
                  "minLength": 1
                },
                "source_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "locator": {
                  "type": "string",
                  "minLength": 1
                },
                "retrieved_at": {
                  "type": "string",
                  "format": "date-time"
                }
              },
              "additionalProperties": true
            }
          },
          "rights": {
            "type": "object",
            "required": [
              "source",
              "assertion"
            ],
            "properties": {
              "source": {
                "type": "string",
                "format": "uri"
              },
              "assertion": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": true
}
