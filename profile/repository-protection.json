{
  "schema": "ey-repository-protection-policy.v1",
  "branch": "main",
  "pull_request_required": true,
  "required_checks": ["release-gate"],
  "required_check_dependencies": ["fixture", "reader"],
  "strict_up_to_date_checks": true,
  "required_external_reviews": 0,
